+{
+  ThunarStandardView *standard_view = THUNAR_STANDARD_VIEW (icon_view);
+  ExoIconView        *exo_icon_view = EXO_ICON_VIEW (gtk_bin_get_child (GTK_BIN (standard_view)));
+  gint                column_spacing;
+  gint                margin;
+  gint                focus_width;
+  gint                available;
+  gint                cost;
+  gint                columns;
+  gint                item_width;
+  gint                xpad;
+
+  if (exo_icon_view_get_orientation (exo_icon_view) == GTK_ORIENTATION_HORIZONTAL
+      || icon_view->base_item_width <= 0)
+    return;
 
   column_spacing = exo_icon_view_get_column_spacing (exo_icon_view);
+  margin = exo_icon_view_get_margin (exo_icon_view);
+  gtk_widget_style_get (GTK_WIDGET (exo_icon_view), "focus-line-width", &focus_width, NULL);
+
+  /* ExoIconView puts another item in a row while  2 * (margin + focus) + n * (item + spacing + 2 * focus)  still fits
+   * in the allocated width, so that is the cost of one column */
+  available = gtk_widget_get_allocated_width (GTK_WIDGET (exo_icon_view)) - 2 * (margin + focus_width);
+  cost = icon_view->base_item_width + column_spacing + 2 * focus_width;
+  if (available <= cost)
+    item_width = icon_view->base_item_width;
+  else
