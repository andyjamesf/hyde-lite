+/* In the details view every cell clips its background to one pill spanning the visible part of the row */
+static void
+thunar_util_clip_row_pill (cairo_t            *cr,
+                           GtkTreeView        *tree_view,
+                           const GdkRectangle *background_area)
+{
+  GtkAdjustment *hadjustment = gtk_scrollable_get_hadjustment (GTK_SCROLLABLE (tree_view));
+  GdkRectangle   row = *background_area;
+
+  row.x = ROW_PILL_INSET + (hadjustment != NULL ? (gint) gtk_adjustment_get_value (hadjustment) : 0);
+  row.width = gtk_widget_get_allocated_width (GTK_WIDGET (tree_view)) - 2 * ROW_PILL_INSET;
+
+  /* a gap between neighbouring pills, so several selected rows read as several */
+  row.y += 1;
+  row.height -= 2;
+
+  thunar_util_draw_rounded_corners (cr, &row, row.height / 2.0, DRAW_ON_ALL_SIDES);
+}
