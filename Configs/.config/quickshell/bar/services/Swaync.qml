pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io

// Keeps swaync in the same colors as the bar: on every palette change (theme, wallpaper or the
// shell's "wallpaper colors" option) it writes swaync's CSS variables and tells it to reload
// its style. ~/.config/swaync/style.css imports this file (quickshell-colors.css).
// Temporary: in phase 3 swaync is replaced by the shell's own notifications.
Singleton {
    id: root

    // Next to swaync's style.css (like HyDE's theme.css), so the import is relative and doesn't
    // depend on the user name. It is generated: it doesn't go into the repository.
    readonly property string path: `${Quickshell.env("XDG_CONFIG_HOME") || Quickshell.env("HOME") + "/.config"}/swaync/quickshell-colors.css`

    function rgb(c) {
        return `${Math.round(c.r * 255)}, ${Math.round(c.g * 255)}, ${Math.round(c.b * 255)}`;
    }

    function rgba(c, a) {
        return `rgba(${rgb(c)}, ${a})`;
    }

    function css() {
        const r = Theme.toRoles;
        const radius = BarLayout.hyprRounding + 4;
        return `/* Generated by the Quickshell shell (services/Swaync.qml): do not edit. */
:root {
  --cc-bg: ${rgba(r.surface, 0.88)};
  --noti-border-color: ${rgba(r.outlineVariant, 0.7)};
  --noti-bg: ${rgb(r.surfaceContainer)};
  --noti-bg-alpha: 0.94;
  --noti-bg-darker: rgb(${rgb(r.surface)});
  --noti-bg-hover: rgb(${rgb(r.surfaceContainerHigh)});
  --noti-bg-focus: ${rgba(r.surfaceContainerHigh, 0.7)};
  --noti-close-bg: ${rgba(r.surfaceContainerHighest, 0.9)};
  --noti-close-bg-hover: ${rgba(r.primary, 0.45)};
  --text-color: rgb(${rgb(r.text)});
  --text-color-disabled: rgb(${rgb(r.textFaint)});
  --bg-selected: rgb(${rgb(r.primary)});
  --border-radius: ${radius}px;
  --qs-radius-small: ${Math.max(6, radius - 6)}px;
  --qs-primary: rgb(${rgb(r.primary)});
  --qs-on-primary: rgb(${rgb(r.onPrimary)});
  --qs-primary-container: rgb(${rgb(r.primaryContainer)});
  --qs-text-dim: rgb(${rgb(r.textDim)});
  --qs-container-high: rgb(${rgb(r.surfaceContainerHigh)});
  --qs-container-highest: rgb(${rgb(r.surfaceContainerHighest)});
  --qs-error: ${Theme.dark ? "rgb(243, 139, 168)" : "rgb(210, 15, 57)"};
}
`;
    }

    function apply() {
        file.setText(css());
    }

    // Only after the file is written, and only if swaync is running.
    function reloadSwaync() {
        Quickshell.execDetached(["sh", "-c", "pgrep -x swaync >/dev/null && swaync-client -rs >/dev/null"]);
    }

    Connections {
        target: Theme
        function onToRolesChanged() {
            root.apply();
        }
    }

    Connections {
        target: BarLayout
        function onHyprRoundingChanged() {
            root.apply();
        }
    }

    FileView {
        id: file
        path: root.path
        printErrors: false
        onSaved: root.reloadSwaync()
    }

    Component.onCompleted: apply()
}
