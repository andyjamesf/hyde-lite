pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io

// Shell colors. Four sources (picked in the HyDE menu, in Prefs.colorSource):
//
//  - "matugen": the Material You palette that `wallpaper-palette` derives from the wallpaper
//    (~/.cache/morphing-island/matugen.json), in the scheme and mode chosen with Super+Shift+C. Its roles
//    (surface, primary, on_surface...) are used as they are: going through wall.dcol instead turned
//    every scheme into nearly the same bar, because the dcol groups are not matugen's roles.
//
//  - "hyde" (default): the colors each HyDE theme designed for the bar — the
//    ~/.config/waybar/theme.css that HyDE rewrites on every theme change (from the
//    theme's waybar.theme, or from wallbash in wallbash mode). The bar takes on the theme's look.
//  - "wallbash": the theme's full palette, generated by the template
//    ~/.config/hyde/wallbash/always/quickshell.dcol.
//  - "wallpaper": the colors extracted from the current wallpaper (~/.cache/hyde/wall.dcol).
//
// All sources are watched: when the theme or wallpaper changes, the colors transition by themselves.
Singleton {
    id: root

    // Current HyDE palette used when no file exists (Catppuccin Macchiato).
    readonly property var fallbackCss: ({
            "main-bg": "#181926",
            "main-fg": "#cad3f5",
            "wb-act-bg": "#c6a0f6",
            "wb-act-fg": "#363a4f",
            "wb-hvr-bg": "#cad3f5",
            "wb-hvr-fg": "#363a4f"
        })

    property var themeCss: fallbackCss
    property var wallbashPalette: null
    property var wallPalette: null
    property var matugenPalette: null
    // Raw text of the last wall.dcol that was parsed, so the re-reads of `settle` below only
    // publish a real change (one transition per wallpaper, not one per read).
    property string _dcolText: ""

    readonly property string source: Prefs.colorSource === "matugen" && matugenPalette ? "matugen" : Prefs.colorSource === "wallpaper" && wallPalette ? "wallpaper" : Prefs.colorSource === "wallbash" && wallbashPalette ? "wallbash" : "hyde"
    readonly property var targetRoles: ensureReadable(source === "matugen" ? matugenRoles(matugenPalette) : source === "wallpaper" ? paletteRoles(wallPalette) : source === "wallbash" ? paletteRoles(wallbashPalette) : cssRoles(themeCss))

    // Each color is a blend between the previous and the new colors, driven by `progress`:
    // a single animation transitions all of them (many Behaviors in a singleton crash Qt).
    property var fromRoles: cssRoles(fallbackCss)
    property var toRoles: cssRoles(fallbackCss)
    property real progress: 1

    readonly property bool dark: luminance(surface) < 0.5

    // Semantic roles (Material 3-style names).
    readonly property color surface: mix("surface")
    readonly property color surfaceContainer: mix("surfaceContainer")
    readonly property color surfaceContainerHigh: mix("surfaceContainerHigh")
    readonly property color surfaceContainerHighest: mix("surfaceContainerHighest")
    readonly property color text: mix("text")
    readonly property color textDim: mix("textDim")
    readonly property color textFaint: mix("textFaint")
    readonly property color outline: mix("outline")
    readonly property color outlineVariant: mix("outlineVariant")
    readonly property color primary: mix("primary")
    readonly property color onPrimary: mix("onPrimary")
    readonly property color primaryContainer: mix("primaryContainer")
    readonly property color onPrimaryContainer: mix("onPrimaryContainer")
    readonly property color secondary: mix("secondary")
    readonly property color tertiary: mix("tertiary")
    // Status colors: fixed base, adjusted to be readable on the theme background (light or dark).
    readonly property color error: readable("#f38ba8", surface, 3)
    readonly property color warning: readable("#f9e2af", surface, 3)
    readonly property color success: readable("#a6e3a1", surface, 3)

    // State layers (hover/press) on top of any surface.
    readonly property color hover: Qt.alpha(text, 0.08)
    readonly property color pressed: Qt.alpha(text, 0.12)

    // --- Design system -------------------------------------------------------------------------
    // Every panel uses these values (no magic numbers): the same spacing rhythm, the
    // same type scale and the same shapes across the whole shell. The bar has its own scale,
    // which follows the chosen height (BarLayout).

    // Spacing, on a 4 px grid.
    readonly property int space1: 4
    readonly property int space2: 8
    readonly property int space3: 12
    readonly property int space4: 16
    readonly property int space5: 20
    readonly property int space6: 24

    // Type scale (sizes in logical px).
    readonly property int labelSmall: 11
    readonly property int labelMedium: 12
    readonly property int labelLarge: 13
    readonly property int bodySmall: 12
    readonly property int bodyMedium: 13
    readonly property int titleSmall: 14
    readonly property int titleMedium: 16
    readonly property int titleLarge: 20
    readonly property int headline: 24
    readonly property int displaySmall: 36
    readonly property int display: 56

    // Shapes: corner radii, from the smallest (list rows) to whole panels.
    readonly property int shapeSmall: 10
    readonly property int shapeMedium: 14
    readonly property int shapeLarge: 20
    readonly property int shapeXL: 28

    // Thin outline, the same on every floating surface.
    readonly property color border: Qt.alpha(outlineVariant, 0.6)

    function alpha(color, a) {
        return Qt.alpha(color, a);
    }

    function luminance(c) {
        return 0.2126 * c.r + 0.7152 * c.g + 0.0722 * c.b;
    }

    // --- Contrast (WCAG 2) --------------------------------------------------------------------
    // HyDE themes don't always guarantee contrast between text and background (especially light ones),
    // and the bar islands may have a different background from the theme's. All text and
    // icon colors go through readable(), which darkens or lightens them just enough to be readable.

    function relativeLuminance(c) {
        c = Qt.color(c);
        const lin = v => v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
        return 0.2126 * lin(c.r) + 0.7152 * lin(c.g) + 0.0722 * lin(c.b);
    }

    function contrast(a, b) {
        const la = relativeLuminance(a), lb = relativeLuminance(b);
        return (Math.max(la, lb) + 0.05) / (Math.min(la, lb) + 0.05);
    }

    // Returns `fg` if it already has the minimum contrast against `bg`; otherwise moves it towards black or white
    // (whichever contrasts more with the background) until it gets there, keeping the hue as much as possible.
    function readable(fg, bg, minRatio) {
        fg = Qt.color(fg);
        bg = Qt.color(bg);
        const ratio = minRatio ?? 4.5;
        if (contrast(fg, bg) >= ratio)
            return fg;
        const target = contrast("#000000", bg) > contrast("#ffffff", bg) ? "#000000" : "#ffffff";
        for (let t = 0.1; t < 1; t += 0.1) {
            const c = blend(fg, target, t);
            if (contrast(c, bg) >= ratio)
                return Qt.rgba(c.r, c.g, c.b, fg.a);
        }
        return Qt.color(target);
    }

    // Final readability pass over a theme's roles.
    function ensureReadable(r) {
        r.text = readable(r.text, r.surface, 4.5);
        r.textDim = readable(r.textDim, r.surface, 3.5);
        r.textFaint = readable(r.textFaint, r.surface, 2.6);
        r.primary = readable(r.primary, r.surface, 3);
        r.onPrimary = readable(r.onPrimary, r.primary, 4.5);
        r.onPrimaryContainer = readable(r.onPrimaryContainer, r.primaryContainer, 4.5);
        r.secondary = readable(r.secondary, r.surface, 3);
        r.tertiary = readable(r.tertiary, r.surface, 3);
        return r;
    }

    // Linear blend of two colors (t = 0 → a, t = 1 → b), always opaque.
    function blend(a, b, t) {
        a = Qt.color(a);
        b = Qt.color(b);
        return Qt.rgba(a.r + (b.r - a.r) * t, a.g + (b.g - a.g) * t, a.b + (b.b - a.b) * t, 1);
    }

    // theme.css color with transparency (e.g. rgba(…, 0.4) in wallbash mode) composited over the
    // background, to get the color actually seen.
    function flatten(c, over) {
        c = Qt.color(c);
        return c.a >= 0.99 ? Qt.rgba(c.r, c.g, c.b, 1) : blend(over, Qt.rgba(c.r, c.g, c.b, 1), c.a);
    }

    // Qt doesn't understand "rgba(r, g, b, a)" with 0..255 components; it is converted here.
    function cssColor(v) {
        const m = /^rgba?\(([^)]*)\)$/.exec(String(v).trim());
        if (!m)
            return Qt.color(v);
        const p = m[1].split(",").map(s => parseFloat(s));
        return Qt.rgba(p[0] / 255, p[1] / 255, p[2] / 255, p.length > 3 ? p[3] : 1);
    }

    // The HyDE theme only defines the main bar colors; the intermediate shades are derived from them.
    function cssRoles(css) {
        const get = k => cssColor(css[k] ?? fallbackCss[k]);
        const surface = flatten(get("main-bg"), "#000000");
        const text = flatten(get("main-fg"), surface);
        const primary = flatten(get("wb-act-bg"), surface);
        const onPrimary = flatten(get("wb-act-fg"), primary);
        const hoverBg = flatten(get("wb-hvr-bg"), surface);
        return {
            "surface": surface,
            "surfaceContainer": blend(surface, text, 0.06),
            "surfaceContainerHigh": blend(surface, text, 0.1),
            "surfaceContainerHighest": blend(surface, text, 0.16),
            "text": text,
            "textDim": blend(text, surface, 0.22),
            "textFaint": blend(text, surface, 0.38),
            "outline": blend(surface, text, 0.32),
            "outlineVariant": blend(surface, text, 0.18),
            "primary": primary,
            "onPrimary": onPrimary,
            "primaryContainer": blend(surface, primary, 0.32),
            "onPrimaryContainer": blend(text, primary, 0.15),
            "secondary": hoverBg,
            "tertiary": blend(primary, text, 0.35)
        };
    }

    // Wallbash palette: 4 groups (pry1..4, from dominant to accent), each with a contrast text
    // (txtN) and 9 shades (NxaM) going from the background shade (xa1) to the text shade (xa9), in both
    // dark and light mode.
    // The n-th shade of a group, counted from the background end: shade(p, 1, 1) is always the one
    // next to pry1 and shade(p, 1, 9) the one next to the text.
    //
    // Wallbash usually emits xa1…xa9 in that order, but for some wallpapers it emits them the other
    // way round (xa1 is then the shade beside the text, not beside the background). Reading the
    // ladder by position would paint the islands with the text-side shade and the dim text with the
    // background-side one — both ending up the same colour as what they sit on, so nothing on the
    // bar can be read. The direction is measured instead of assumed.
    function shade(p, group, n) {
        const at = i => p[`${group}xa${i}`];
        const first = at(1), last = at(9);
        if (first === undefined || last === undefined)
            return Qt.color(at(n) ?? "#ff00ff");
        const base = Qt.color(p[`pry${group}`] ?? p["pry1"] ?? "#000000");
        const l = c => relativeLuminance(Qt.color(c));
        const flipped = Math.abs(l(first) - l(base)) > Math.abs(l(last) - l(base));
        return Qt.color(at(flipped ? 10 - n : n) ?? "#ff00ff");
    }

    function paletteRoles(p) {
        const get = k => Qt.color(p[k] ?? "#ff00ff");
        const s = (group, n) => shade(p, group, n);
        return {
            "surface": get("pry1"),
            "surfaceContainer": s(1, 1),
            "surfaceContainerHigh": s(1, 2),
            "surfaceContainerHighest": s(1, 3),
            "text": get("txt1"),
            "textDim": s(1, 7),
            "textFaint": s(1, 6),
            "outline": s(1, 4),
            "outlineVariant": s(1, 3),
            "primary": s(4, 7),
            "onPrimary": s(4, 1),
            "primaryContainer": s(4, 3),
            "onPrimaryContainer": s(4, 9),
            "secondary": s(2, 7),
            "tertiary": s(3, 7)
        };
    }

    // matugen's Material You roles. `default` is the polarity matugen was asked for (the engine passes
    // -m dark|light|smart), so the scheme and mode chosen in the picker are what is read here.
    function matugenRoles(j) {
        const c = j.colors ?? {};
        const get = role => Qt.color(c[role]?.default?.color ?? c[role]?.dark?.color ?? "#ff00ff");
        const surface = get("surface");
        const text = get("on_surface");
        return {
            "surface": surface,
            "surfaceContainer": get("surface_container"),
            "surfaceContainerHigh": get("surface_container_high"),
            "surfaceContainerHighest": get("surface_container_highest"),
            "text": text,
            "textDim": get("on_surface_variant"),
            "textFaint": blend(text, surface, 0.38),
            "outline": get("outline"),
            "outlineVariant": get("outline_variant"),
            "primary": get("primary"),
            "onPrimary": get("on_primary"),
            "primaryContainer": get("primary_container"),
            "onPrimaryContainer": get("on_primary_container"),
            "secondary": get("secondary"),
            "tertiary": get("tertiary")
        };
    }

    function mix(role) {
        const a = fromRoles[role], b = toRoles[role], t = progress;
        return Qt.rgba(a.r + (b.r - a.r) * t, a.g + (b.g - a.g) * t, a.b + (b.b - a.b) * t, a.a + (b.a - a.a) * t);
    }

    // New colors: start from the ones on screen right now (even midway through another transition).
    onTargetRolesChanged: {
        const current = {};
        for (const role in targetRoles)
            current[role] = root[role];
        fromRoles = current;
        toRoles = targetRoles;
        progress = 0;
        transition.restart();
    }

    function setColorSource(source) {
        Prefs.colorSource = source;
        Prefs.save();
    }

    NumberAnimation {
        id: transition
        target: root
        property: "progress"
        from: 0
        to: 1
        duration: Anim.slow
        easing.type: Easing.BezierSpline
        easing.bezierCurve: Anim.standard
    }

    // Bar colors of the HyDE theme (@define-color name value;). HyDE rewrites this one in place on
    // every theme *and* wallpaper change, so it is also what tells the wallpaper palette to re-read.
    FileView {
        path: `${Quickshell.env("XDG_CONFIG_HOME") || Quickshell.env("HOME") + "/.config"}/waybar/theme.css`
        watchChanges: true
        printErrors: false
        onFileChanged: {
            reload();
            root.reloadWallpaper();
        }
        onLoaded: {
            const out = {};
            const re = /@define-color\s+([\w-]+)\s+([^;]+);/g;
            const css = text().replace(/\/\*[\s\S]*?\*\//g, "");
            let m;
            while ((m = re.exec(css)) !== null) {
                const v = m[2].trim();
                const value = v.startsWith("@") ? out[v.slice(1)] : v;
                if (value !== undefined)
                    out[m[1]] = value;
            }
            if (out["main-bg"])
                root.themeCss = out;
        }
    }

    FileView {
        path: `${Quickshell.env("XDG_CACHE_HOME") || Quickshell.env("HOME") + "/.cache"}/hyde/wallbash/quickshell.json`
        watchChanges: true
        printErrors: false
        onFileChanged: reload()
        onLoaded: {
            try {
                root.wallbashPalette = JSON.parse(text());
            } catch (e) {
                // Wallbash writes the file in one go; a half-written JSON only happens for an instant.
            }
        }
        onLoadFailed: root.wallbashPalette = null
    }

    // The engine writes this through a temporary file and renames it over, so a half-written JSON is
    // never seen; a failed parse keeps the palette that is on screen.
    FileView {
        path: `${Quickshell.env("XDG_CACHE_HOME") || Quickshell.env("HOME") + "/.cache"}/morphing-island/matugen.json`
        watchChanges: true
        printErrors: false
        onFileChanged: reload()
        onLoaded: {
            try {
                const j = JSON.parse(text());
                if (j.colors?.surface)
                    root.matugenPalette = j;
            } catch (e) {
            }
        }
        onLoadFailed: root.matugenPalette = null
    }

    // Format: dcol_pry1="23162D", dcol_1xa1="402952", dcol_mode="dark"…
    //
    // wall.dcol is a symlink to ~/.cache/hyde/dcols/<sha1 of the wallpaper>.dcol, and on a wallpaper
    // change HyDE only re-points it: the dcol files themselves are a per-wallpaper cache, written
    // once and never touched again. inotify follows the link, so the watch stays on the previous
    // wallpaper's file and onFileChanged never arrives — without `settle` below, the "wallpaper"
    // source would keep the colors it had when the shell started.
    FileView {
        id: dcolFile
        path: `${Quickshell.env("XDG_CACHE_HOME") || Quickshell.env("HOME") + "/.cache"}/hyde/wall.dcol`
        watchChanges: true
        printErrors: false
        onFileChanged: reload()
        onLoaded: {
            const src = text();
            if (src === root._dcolText)
                return;
            root._dcolText = src;
            const p = {};
            const re = /^dcol_(mode|pry\d|txt\d|\dxa\d)="([^"]*)"/gm;
            let m;
            while ((m = re.exec(src)) !== null)
                p[m[1]] = m[1] === "mode" ? m[2] : `#${m[2]}`;
            root.wallPalette = p.pry1 ? p : null;
        }
        onLoadFailed: {
            root._dcolText = "";
            root.wallPalette = null;
        }
    }

    // HyDE renders the wallbash templates first and re-points wall.dcol about a second later, so the
    // link is still the old one when theme.css changes. Every template change therefore starts a
    // short burst of re-reads, which stops by itself once the link has moved (6 s at most, and
    // nothing runs in between).
    Timer {
        id: settle
        interval: 300
        repeat: true
        property int tries: 0
        onTriggered: {
            dcolFile.reload();
            if (++tries >= 20)
                stop();
        }
    }

    // Re-reads the wallpaper palette after a HyDE change (see `settle`).
    function reloadWallpaper() {
        settle.tries = 0;
        settle.restart();
    }
}
