#!/usr/bin/env python3
"""Chooses which Material You palette the current wallpaper produces.

matugen derives a whole tonal system from one seed colour in the image, and the
scheme decides how: the same wallpaper gives a muted palette as `tonal-spot` and
a loud one as `vibrant`. Without this, every wallpaper had exactly one palette.

    wallpaper-palette list            the schemes, with the current one marked
    wallpaper-palette get             the current scheme and mode
    wallpaper-palette set <scheme> [dark|light|auto]
    wallpaper-palette mode [next|prev|dark|light|auto]
    wallpaper-palette next | prev     step through the schemes
    wallpaper-palette apply [--force] [--after-hyde]
                                      regenerate with whatever is set (--after-hyde: HyDE is
                                      mid-change, so its rebuild waits a moment)
    wallpaper-palette preview         per scheme: id, label, note and a swatch image of
                                      the colours it gives THIS wallpaper (for the pickers)

The choice lives in the island's prefs next to `theme.mode`, which
wallbash-matugen already reads, so both go on being one setting in one file.

Dark and light have ONE source of truth: `theme.mode`. HyDE keeps its own copy
(`enableWallDcol`: 1 auto, 2 dark, 3 light) and uses it to INVERT its templates when the
palette's polarity is not the one it was told to want. matugen already generates the
polarity asked for, so a flag that disagrees with it inverts a palette that was right:
dark asked for, flag on light, and the apps came out inverted. Every change of mode here
writes both, so they cannot disagree; a flag set at 0 (HyDE's own theme colours) is left
alone, because then wallbash is not in use at all.

Speed. Recolouring the island and the HyDE shell is one matugen run (about 0.4 s) and they
follow matugen.json at once. Rebuilding HyDE's templates (kitty, rofi, GTK, Qt...) is what
takes seconds, so it runs detached and queued, and the command returns without it. A run
whose inputs (wallpaper, scheme, mode) are what the last run used does nothing, which is
what stops the island, the wallbash hook and the rebuild itself from repeating the work.

`apply` writes ~/.cache/morphing-island/matugen.json (the island watches it and
recolours itself), has matugen write its own templates (Hyprland borders, GTK,
kitty), and then runs wallbash-matugen, which turns the same palette into
HyDE's wall.dcol so kitty's ANSI colours, rofi, waybar, Kvantum, kdeglobals and
the rest follow too.

The island runs `apply` on every wallpaper change, so this file is the only
place the matugen command lives.
"""
import concurrent.futures
import fcntl
import hashlib
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys

HOME = pathlib.Path.home()
CACHE = pathlib.Path(os.environ.get("XDG_CACHE_HOME", HOME / ".cache"))
STATE = pathlib.Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state"))
PREFS = STATE / "morphing-island" / "prefs.json"
WALL = CACHE / "hyde" / "wall.set"
OUT = CACHE / "morphing-island" / "matugen.json"
STAMP = OUT.parent / "palette.stamp"
LOCK = OUT.parent / "palette.lock"
REBUILD_LOCK = OUT.parent / "rebuild.lock"
STATERC = STATE / "hyde" / "staterc"
# HyDE's enableWallDcol for each mode (0 is "the theme's own colours", not a mode).
MODE_FLAG = {"auto": 1, "dark": 2, "light": 3}
PREVIEWS = CACHE / "morphing-island" / "palette-previews"
KEEP_PREVIEWS = 6  # wallpapers' worth of swatches kept on disk

# id -> (label, what it does to the image's colours)
SCHEMES = [
    ("scheme-tonal-spot", "Tonal Spot", "balanced, the Material You default"),
    ("scheme-vibrant", "Vibrant", "the strongest colour in the image, pushed"),
    ("scheme-expressive", "Expressive", "accents away from the image's own hue"),
    ("scheme-content", "Content", "keeps the image's colours as they are"),
    ("scheme-fidelity", "Fidelity", "closest to the image, least invented"),
    ("scheme-fruit-salad", "Fruit Salad", "playful, several hues at once"),
    ("scheme-rainbow", "Rainbow", "accents spread around the colour wheel"),
    ("scheme-neutral", "Neutral", "barely tinted, close to grey"),
    ("scheme-monochrome", "Monochrome", "greys only"),
    ("scheme-smart", "Smart", "matugen picks the scheme for the image"),
]
IDS = [s[0] for s in SCHEMES]
DEFAULT = "scheme-tonal-spot"
MODES = ("auto", "dark", "light")


def die(msg, code=1):
    sys.stderr.write(f"wallpaper-palette: {msg}\n")
    raise SystemExit(code)


def prefs():
    try:
        with open(PREFS) as fh:
            return json.load(fh)
    except Exception:
        return {}


def save(**changes):
    """Merges keys into the prefs file, leaving everything else untouched."""
    data = prefs()
    data.update(changes)
    PREFS.parent.mkdir(parents=True, exist_ok=True)
    tmp = PREFS.with_suffix(".json.tmp")
    with open(tmp, "w") as fh:
        json.dump(data, fh, indent=4, sort_keys=True)
        fh.write("\n")
    tmp.replace(PREFS)


def current():
    p = prefs()
    scheme = p.get("theme.scheme", DEFAULT)
    if scheme not in IDS:
        scheme = DEFAULT
    mode = p.get("theme.mode", "auto")
    return scheme, (mode if mode in MODES else "auto")


def hyde_flag(mode):
    """Keeps HyDE's enableWallDcol in step with `mode` (see the top of this file)."""
    try:
        text = STATERC.read_text()
    except OSError:
        return
    m = re.search(r'^enableWallDcol="?(\d)"?\s*$', text, re.M)
    if not m or m.group(1) == "0":
        return
    new = str(MODE_FLAG[mode])
    if m.group(1) != new:
        STATERC.write_text(re.sub(r'^enableWallDcol=.*$', f'enableWallDcol="{new}"', text, flags=re.M))


def apply(force=False, hyde_busy=False):
    """Regenerates the palette for the wallpaper that is set.

    Serialised: the island and HyDE's wallbash hook can both ask for this on one wallpaper change,
    and two runs would write the same temporary files. The second waits, then finds the work done."""
    OUT.parent.mkdir(parents=True, exist_ok=True)
    with open(LOCK, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        return _apply(force, hyde_busy)


def _apply(force, hyde_busy):
    wall = WALL.resolve()
    if not wall.is_file():
        die(f"no wallpaper at {WALL}")
    scheme, mode = current()
    st = wall.stat()
    key = f"{wall}|{st.st_mtime_ns}|{st.st_size}|{scheme}|{mode}"
    # Same inputs as the last run: nothing to do. This is what makes the second pass cheap when the
    # rebuild below touches files that make the island or the wallbash hook ask again.
    try:
        if not force and OUT.exists() and STAMP.read_text() == key:
            return scheme, mode
    except OSError:
        pass
    # "auto" is matugen's own light/dark decision for the image.
    cmd = ["matugen", "--json", "hex", "--prefer", "saturation",
           "-t", scheme, "-m", "smart" if mode == "auto" else mode,
           "image", str(wall)]
    try:
        done = subprocess.run(cmd, capture_output=True, text=True)
    except FileNotFoundError:
        die("matugen is not installed")
    if done.returncode != 0:
        die(done.stderr.strip() or "matugen failed")
    # Written through a temporary file so the island never reads half a JSON.
    tmp = OUT.with_suffix(".json.tmp")
    tmp.write_text(done.stdout)
    tmp.replace(OUT)
    STAMP.write_text(key)
    rebuild_hyde(3 if hyde_busy else 0)
    return scheme, mode


def rebuild_hyde(delay=0):
    """Hands the palette to HyDE (kitty ANSI, rofi, waybar, GTK, Qt/KDE...), in the background.

    This is the slow part, a couple of seconds, and nothing on screen waits for it: the island and
    the HyDE shell already follow matugen.json. Queued on a lock instead of run at once, so
    stepping through schemes quickly never has two rebuilds going at the same time; the ones
    queued behind the first find the palette already matches and end immediately.

    `delay` is for when HyDE itself is in the middle of a wallpaper change (the wallbash hook calls
    with --after-hyde): the island has what it needs at once, and only the rebuild waits for HyDE's
    own templates to finish instead of racing them."""
    if not shutil.which("wallbash-matugen"):
        return
    subprocess.Popen(["sh", "-c", 'sleep "$2"; flock "$1" wallbash-matugen', "sh", str(REBUILD_LOCK), str(delay)],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)


def role(colors, name, dark):
    entry = colors[name]
    return (entry.get("dark" if dark else "light") or entry["default"])["color"]


def swatch(scheme, wall, folder):
    """Writes 2x2 images of the scheme's surface, primary, secondary and tertiary, dark and light.

    matugen generates both polarities in one run, so changing the mode never needs a new one."""
    cmd = ["matugen", "--json", "hex", "--prefer", "saturation", "-t", scheme, "-m", "smart",
           "image", str(wall)]
    done = subprocess.run(cmd, capture_output=True, text=True)
    if done.returncode != 0:
        return
    data = json.loads(done.stdout)
    (folder / "natural").write_text("dark" if data.get("is_dark_mode") else "light")
    for polarity in ("dark", "light"):
        tiles = [role(data["colors"], n, polarity == "dark")
                 for n in ("surface", "primary", "secondary", "tertiary")]
        dest = folder / f"{scheme}-{polarity}.png"
        tmp = dest.with_suffix(".tmp.png")
        subprocess.run(["magick", "-size", "24x24", f"xc:{tiles[0]}", f"xc:{tiles[1]}", "+append",
                        "(", f"xc:{tiles[2]}", f"xc:{tiles[3]}", "+append", ")", "-append", str(tmp)],
                       check=True, capture_output=True)
        tmp.replace(dest)


def preview():
    """TSV for the pickers. Swatches are cached per wallpaper and mode, so only the first
    opening after a wallpaper change pays for ten matugen runs (done side by side)."""
    wall = WALL.resolve()
    if not wall.is_file():
        die(f"no wallpaper at {WALL}")
    if not shutil.which("magick"):
        die("ImageMagick is needed for the swatches")
    st = wall.stat()
    key = hashlib.sha1(f"{wall}{st.st_mtime_ns}{st.st_size}".encode()).hexdigest()[:16]
    folder = PREVIEWS / key
    folder.mkdir(parents=True, exist_ok=True)
    # Old wallpapers' swatches go; this one's stay.
    others = sorted((d for d in PREVIEWS.iterdir() if d.is_dir() and d != folder),
                    key=lambda d: d.stat().st_mtime, reverse=True)
    for old in others[KEEP_PREVIEWS - 1:]:
        shutil.rmtree(old, ignore_errors=True)

    def one(entry):
        sid = entry[0]
        if not ((folder / f"{sid}-dark.png").exists() and (folder / f"{sid}-light.png").exists()):
            swatch(sid, wall, folder)

    with concurrent.futures.ThreadPoolExecutor(max_workers=5) as pool:
        list(pool.map(one, SCHEMES))
    scheme, mode = current()
    # Auto shows what the image itself would give.
    try:
        polarity = mode if mode in ("dark", "light") else (folder / "natural").read_text().strip()
    except OSError:
        polarity = "dark"
    files = [folder / f"{sid}-{polarity}.png" for sid, _, _ in SCHEMES]
    print(f"@@CURRENT@@\t{scheme}\t{mode}")
    for (sid, label, note), png in zip(SCHEMES, files, strict=True):
        print(f"{sid}\t{label}\t{note}\t{png if png.exists() else ''}")


def main():
    args = sys.argv[1:]
    cmd = args[0] if args else "get"
    scheme, mode = current()

    if cmd == "list":
        for sid, label, note in SCHEMES:
            print(f"{'*' if sid == scheme else ' '} {sid}\t{label}\t{note}")
    elif cmd == "get":
        print(f"{scheme} {mode}")
    elif cmd == "set":
        if len(args) < 2:
            die("set needs a scheme (see `wallpaper-palette list`)")
        if args[1] not in IDS:
            die(f"unknown scheme {args[1]}")
        new_mode = args[2] if len(args) > 2 else mode
        if new_mode not in MODES:
            die(f"mode must be one of {', '.join(MODES)}")
        save(**{"theme.scheme": args[1], "theme.mode": new_mode})
        hyde_flag(new_mode)
        print(" ".join(apply()))
    elif cmd == "mode":
        want = args[1] if len(args) > 1 else "next"
        if want in ("next", "prev"):
            want = MODES[(MODES.index(mode) + (1 if want == "next" else -1)) % len(MODES)]
        if want not in MODES:
            die(f"mode must be next, prev or one of {', '.join(MODES)}")
        save(**{"theme.mode": want})
        hyde_flag(want)
        print(" ".join(apply()))
    elif cmd in ("next", "prev"):
        step = 1 if cmd == "next" else -1
        save(**{"theme.scheme": IDS[(IDS.index(scheme) + step) % len(IDS)]})
        print(" ".join(apply()))
    elif cmd == "apply":
        print(" ".join(apply(force="--force" in args, hyde_busy="--after-hyde" in args)))
    elif cmd == "preview":
        preview()
    else:
        die(__doc__.strip(), 2)
    return 0


if __name__ == "__main__":
    sys.exit(main())
