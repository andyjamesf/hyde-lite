#!/usr/bin/env bash
# Runs after `git pull` (post-merge) and after a pull that rebases (post-rewrite, same script): brings the
# installed Quickshell configuration up to date with this checkout using tools/sync_shell.py.
# Turn it on once with `bash tools/install_hooks.sh`; turn it off with HYDE_LITE_NO_SYNC=1 for one pull, or
# `git config --unset core.hooksPath` for good.
#
# It never fails the pull: whatever goes wrong here is printed and the exit status stays 0. It only does
# anything when files under Configs/.config/quickshell changed in what was just pulled.
# HYDE_LITE_SHELL_TARGET overrides the folder to update (the tests use it).
set -u
hook=$(basename "$0")
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$root" || exit 0

[ "${HYDE_LITE_NO_SYNC:-}" = 1 ] && exit 0
# post-rewrite is also called for `git commit --amend`; only a rebase brings in other people's changes.
[ "$hook" = post-rewrite ] && [ "${1:-}" != rebase ] && exit 0
command -v python3 >/dev/null || { echo "hyde-lite: python3 not found, installed shell not updated" >&2; exit 0; }

# What came in: for a merge ORIG_HEAD..HEAD; for a rebase git has already moved ORIG_HEAD to the old tip.
range="ORIG_HEAD..HEAD"
git rev-parse --verify -q ORIG_HEAD >/dev/null || exit 0

dir=Configs/.config/quickshell
git diff --quiet "$range" -- "$dir" 2>/dev/null && exit 0
target=${HYDE_LITE_SHELL_TARGET:-$HOME/.config/quickshell}
[ -e "$target" ] || exit 0
if python3 -I tools/sync_shell.py --target "$target" --apply --quiet --keep 5; then
    echo "hyde-lite: restart the shell to load it (island off && island on). Your settings and wallpapers were not touched."
else
    echo "hyde-lite: updating the shell failed (the pull itself is fine); run: python3 tools/sync_shell.py" >&2
fi
exit 0
